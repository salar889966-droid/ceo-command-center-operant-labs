# Server
PORT=8000
NODE_ENV=development
TRUST_PROXY=false
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DB_POOL_MAX=10

# Authentication — generate independent random secrets (32+ bytes each)
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
SERVICE_API_KEY=replace-with-a-different-random-service-secret-at-least-32-bytes

# External integrations (configure only when the target service is ready)
BILLING_PLATFORM_URL=http://localhost:8008
BILLING_JWT_SECRET=replace-with-billing-service-shared-jwt-secret
N8N_WEBHOOK_URL=
